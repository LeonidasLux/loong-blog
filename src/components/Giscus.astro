---
// giscus 评论:Github Discussions 驱动。
// 默认值已内置本仓库(LeonidasLux/loong-blog)的 giscus 配置。
// 如需改仓库/换分类,可用环境变量覆盖(部署环境或 .env):
//   GISCUS_REPO='owner/repo'  GISCUS_REPO_ID='...'
//   GISCUS_CATEGORY='...'  GISCUS_CATEGORY_ID='...'
// 若不小心把所有 env 值显式置空(空串),则优雅降级:仅显示说明,不加载第三方脚本。

interface Props {
  /** giscus 评论归属标识:固定使用文章路径(mapping=specific) */
  term: string;
}
const { term } = Astro.props;
const env = import.meta.env;
// 环境变量优先;缺省时回退到内置的 loong-blog 默认配置(公开信息,非敏感)。
const repo = (env.GISCUS_REPO as string | undefined) ?? 'LeonidasLux/loong-blog';
const repoId = (env.GISCUS_REPO_ID as string | undefined) ?? 'R_kgDOUGwntw';
const category = (env.GISCUS_CATEGORY as string | undefined) ?? 'Announcements';
const categoryId = (env.GISCUS_CATEGORY_ID as string | undefined) ?? 'DIC_kwDOUGwnt84DEXKj';
const enabled = Boolean(repo && repoId && category && categoryId);
---
{
  enabled ? (
    <section class="giscus-wrap">
      <div class="giscus-head">
        <span class="eyebrow">评论 · COMMENTS</span>
        <span class="meta">giscus · GitHub Discussions 驱动</span>
      </div>
      <div class="giscus" data-term={term}>
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={repo}
          data-repo-id={repoId}
          data-category={category}
          data-category-id={categoryId}
          data-mapping="specific"
          data-term={term}
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="zh-CN"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  ) : (
    <aside class="giscus-wrap giscus-placeholder">
      <div class="giscus-head">
        <span class="eyebrow">评论 · COMMENTS</span>
        <span class="meta">giscus · 尚未配置</span>
      </div>
      <p class="meta giscus-note">评论待接入:仓库启用 Discussions 并配置 giscus 环境变量后将自动开启,当前页面不加载任何第三方脚本。</p>
    </aside>
  )
}

<style>
  .giscus-placeholder { opacity: 0.9; }
  .giscus-placeholder .giscus-head .eyebrow { color: var(--color-muted); }
</style>