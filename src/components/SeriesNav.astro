---
// 系列导航:展示当前文章所属系列的全部文章,当前篇高亮。
import { postHref } from '../lib/url';

interface SeriesEntry {
  slug: string;
  title: string;
  seriesOrder?: number;
}
interface Props {
  seriesName: string;
  currentSlug: string;
  posts: SeriesEntry[];
}
const { seriesName, currentSlug, posts } = Astro.props;
const sorted = posts.sort((a, b) => (a.seriesOrder ?? 99) - (b.seriesOrder ?? 99));
---
<nav class="series-nav" aria-label={`系列:${seriesName}`}>
  <p class="series-label">系列 · {seriesName}</p>
  <ol class="series-posts">
    {sorted.map((p) => {
      const isCurrent = p.slug === currentSlug;
      return (
        <li class:list={['series-item', { 'is-current': isCurrent }]}>
          <span class="series-order num">{p.seriesOrder ?? '·'}</span>
          <a href={postHref('articles', p.slug)}>{p.title}</a>
          {isCurrent && <span class="meta series-current">当前</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .series-nav { border: 1px solid var(--color-line); padding: 18px 20px; margin-top: var(--gap-xl); }
  .series-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }
  .series-posts { margin: 12px 0 0; padding: 0; list-style: none; }
  .series-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px dashed var(--color-line);
    font-size: 14px;
  }
  .series-item a:hover { box-shadow: inset 0 -1px 0 var(--color-accent); }
  .series-item.is-current a { color: var(--color-ink); font-weight: 600; }
  .series-order { color: var(--color-muted); min-width: 1.5em; }
  .series-current { margin-left: auto; }
</style>