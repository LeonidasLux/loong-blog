---
// 列表卡片:文章 / 随笔共用,按原型紧凑结构(日期·类型 + 标签同行在上,标题在下)。
// 纯展示组件,数据由页面层传入。
import type { AnyPost } from '../lib/tags';
import { formatDate } from '../lib/date';
import { postHref, withBase } from '../lib/url';

interface Props {
  post: AnyPost;
}

const { post } = Astro.props;
const p = post.data;
const isArticle = post.collection === 'articles';
const typeLabel = isArticle ? '文章' : '随笔';
const href = postHref(post.collection, post.id);
---
<article class="post-item">
  <div class="post-meta-row">
    <span class="meta post-date">{formatDate(p.date)} · {typeLabel}</span>
    {
      p.tags.map((t) => (
        <a class="tag" href={withBase(`/tags/${t}`)}>{t}</a>
      ))
    }
  </div>
  <h3 class="post-title"><a href={href}>{p.title}</a></h3>
</article>

<style>
  .post-item { padding: 16px 0; border-top: 1px solid var(--color-line); }
  .post-item:last-child { border-bottom: 1px solid var(--color-line); }
  .post-date { font-size: 12px; }
  .post-title { font-size: clamp(18px, 1.8vw, 22px); line-height: 1.3; }
  .post-title a { color: var(--color-ink); }
  .post-title a:hover { box-shadow: inset 0 -2px 0 var(--color-accent); }
  .post-meta-row { display: flex; gap: var(--gap-sm); flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
  .post-meta-row .tag { padding: 3px 9px; font-size: 11px; }
</style>
