---
// 系列聚合页:所有系列及系列内文章列表。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postHref } from '../../lib/url';
import { withoutDrafts } from '../../lib/tags';

const articles = withoutDrafts(await getCollection('articles'));

const seriesOrder = articles
  .filter((a) => a.data.series)
  .sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));

const groups = new Map<string, typeof seriesOrder>();
for (const a of seriesOrder) {
  const key = a.data.series!;
  const list = groups.get(key) ?? [];
  list.push(a);
  groups.set(key, list);
}
const seriesList = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh-Hans-CN'));
---
<BaseLayout
  title="系列 · loong-blog"
  description="按系列浏览全部文章——系列内建议顺序阅读。"
>
  <div class="container series-container">
    <header class="section-head">
      <p class="eyebrow">系列 · SERIES</p>
      <h1>系列</h1>
      <p class="lead">成套的长文,按顺序阅读更完整。</p>
    </header>

    {seriesList.map(([name, posts]) => (
      <section class="series-group" aria-label={`系列:${name}`}>
        <div class="series-group-head">
          <h2 class="series-name">{name}</h2>
          <span class="meta num">{posts.length} 篇</span>
        </div>
        <ol class="series-group-list">
          {posts.map((post) => (
            <li class="series-group-item">
              <span class="order num">{post.data.seriesOrder ?? '·'}</span>
              <a href={postHref('articles', post.id)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    {seriesList.length === 0 && (
      <p class="lead">还没有系列文章。在一篇文章的 frontmatter 里填上 `series` 与 `seriesOrder` 即可创建系列。</p>
    )}
  </div>
</BaseLayout>

<style>
  .series-container { max-width: 800px; }
  .section-head { margin-bottom: var(--gap-xl); }
  .series-group { margin-bottom: var(--gap-xl); }
  .series-group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 10px;
    margin-bottom: 6px;
  }
  .series-name { font-size: 26px; }
  .series-group-list { list-style: none; margin: 0; padding: 0; }
  .series-group-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: 17px;
  }
  .series-group-item a:hover { box-shadow: inset 0 -1px 0 var(--color-accent); }
  .order { color: var(--color-muted); min-width: 1.5em; }
</style>