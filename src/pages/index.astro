---
// 首页:双类型列表(Tab 切换)+ 侧栏(更新分布热力图 / 标签 / 关于)。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import ActivityHeatmap from '../components/ActivityHeatmap.astro';
import { aggregateTags, sortByDate, withoutDrafts } from '../lib/tags';
import { formatDate } from '../lib/date';
import { withBase } from '../lib/url';

const [articles, notes] = await Promise.all([
  getCollection('articles'),
  getCollection('notes'),
]);

const publishedArticles = withoutDrafts(articles);
const publishedNotes = withoutDrafts(notes);
const all = sortByDate([...publishedArticles, ...publishedNotes]);
const articleList = sortByDate([...publishedArticles]);
const noteList = sortByDate([...publishedNotes]);
const tags = aggregateTags(all);

// 热力图数据:全部已发布内容的日期 / 标题 / 类型
const activityPosts = all.map((p) => ({
  date: formatDate(p.data.date),
  title: p.data.title,
  kind: p.collection === 'articles' ? '文章' : '随笔',
}));
---
<BaseLayout>
  <div class="container">
    <header class="blog-hero">
      <p class="eyebrow">个人博客 · GITHUB PAGES · SINCE 2026</p>
      <h1>loong-blog</h1>
      <p class="lead">关于 Astro、前端工程与长期主义的记录——长文沉下去,随笔浮上来。</p>
    </header>

    <div class="home-grid grid-2-1">
      <!-- 列表区 -->
      <section aria-label="内容列表">
        <div class="list-tabs" role="tablist" aria-label="内容类型">
          <button class="tab is-active" role="tab" aria-selected="true" data-filter="all">全部 <span class="count">{all.length}</span></button>
          <button class="tab" role="tab" aria-selected="false" data-filter="articles">文章 <span class="count">{articleList.length}</span></button>
          <button class="tab" role="tab" aria-selected="false" data-filter="notes">随笔 <span class="count">{noteList.length}</span></button>
        </div>

        <div class="list-pane" data-pane="all">
          {all.map((post) => <PostCard post={post} />)}
        </div>
        <div class="list-pane" data-pane="articles" hidden>
          {articleList.map((post) => <PostCard post={post} />)}
        </div>
        <div class="list-pane" data-pane="notes" hidden>
          {noteList.map((post) => <PostCard post={post} />)}
        </div>
      </section>

      <!-- 侧栏 -->
      <aside class="sidebar">
        <div class="sidebar-block">
          <ActivityHeatmap posts={activityPosts} />
        </div>
        <div class="sidebar-block">
          <h3 class="sidebar-title">标签</h3>
          <TagList tags={tags} />
        </div>
        <div class="sidebar-block side-about">
          <h3 class="sidebar-title">关于</h3>
          <p>你好,我是 LeonidasLux。技术实践者,偶尔写点长文。这个博客托管在 GitHub Pages,零后端、静态优先。</p>
          <a class="btn btn-ghost btn-arrow" href={withBase('/about')}>了解更多</a>
        </div>
      </aside>
    </div>
  </div>

  <!-- 订阅条 -->
  <section class="subscribe">
    <div class="container">
      <p class="eyebrow subscribe-eyebrow">订阅 · RSS</p>
      <h2 class="subscribe-title">不想错过新文章?</h2>
      <p class="lead subscribe-lead">通过 RSS 订阅全部文章与随笔——零追踪、零噪音,回到阅读本身。</p>
      <a class="btn btn-primary" href={withBase('/rss.xml')}>订阅 RSS</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Tab 切换:三份静态列表,仅在客户端切换显示(不影响 SEO)
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panes = document.querySelectorAll<HTMLElement>('[data-pane]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      panes.forEach((p) => { p.hidden = p.dataset.pane !== tab.dataset.filter; });
    });
  });
</script>

<style>
  /* ── hero(紧凑版,对齐原型 home.html) ── */
  .blog-hero {
    padding-block: clamp(24px, 3.5vw, 40px) clamp(16px, 2.2vw, 26px);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--gap-md);
  }
  .blog-hero .eyebrow { margin-bottom: 10px; font-size: 11px; }
  .blog-hero h1 { font-size: clamp(28px, 3.6vw, 40px); margin-bottom: 6px; line-height: 1.08; }
  .blog-hero .lead { font-size: 15px; line-height: 1.55; }

  .home-grid { gap: var(--gap-lg); padding-bottom: clamp(32px, 4vw, 48px); }

  /* ── tabs ── */
  .list-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--color-line); margin-bottom: var(--gap-md); }
  .tab {
    background: none;
    border: 0;
    padding: 12px 4px;
    margin-right: 22px;
    font-size: 13px;
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  .tab:hover { color: var(--color-ink); }
  .tab.is-active { color: var(--color-ink); border-bottom-color: var(--color-ink); }
  .tab .count { opacity: 0.7; margin-left: 4px; }

  /* ── 侧栏 ── */
  .sidebar { position: sticky; top: 76px; }
  .sidebar-block { padding-bottom: var(--gap-md); margin-bottom: var(--gap-md); border-bottom: 1px solid var(--color-line); }
  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 10px;
    font-weight: 500;
  }
  .side-about p { font-size: 13px; color: var(--color-muted); line-height: 1.6; margin: 0 0 10px; }
  @media (max-width: 920px) { .sidebar { position: static; } }

  /* ── 订阅条 ── */
  .subscribe { border-top: 1px solid var(--color-line); }
  .subscribe .container { text-align: center; padding-block: clamp(28px, 3.5vw, 44px); }
  .subscribe-eyebrow { color: var(--color-muted); margin-bottom: 8px; font-size: 11px; }
  .subscribe-title { font-size: clamp(21px, 2.4vw, 27px); margin-bottom: 6px; }
  .subscribe-lead { margin: 0 auto 16px; font-size: 15px; }
</style>
