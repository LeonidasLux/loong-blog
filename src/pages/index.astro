---
// 首页:双类型列表(Tab 切换)+ 侧栏(标签/系列/关于)。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import { aggregateTags, sortByDate, withoutDrafts } from '../lib/tags';
import { withBase } from '../lib/url';

const [articles, notes] = await Promise.all([
  getCollection('articles'),
  getCollection('notes'),
]);

const publishedArticles = withoutDrafts(articles);
const publishedNotes = withoutDrafts(notes);
const all = sortByDate([...publishedArticles, ...publishedNotes]);
const articleList = sortByDate([...publishedArticles]);
const noteList = sortByDate([...publishedNotes]);
const tags = aggregateTags(all);

// 系列聚合(侧栏)
const seriesMap = new Map<string, number>();
for (const a of publishedArticles) {
  if (a.data.series) seriesMap.set(a.data.series, (seriesMap.get(a.data.series) ?? 0) + 1);
}
const seriesList = [...seriesMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-Hans-CN'));

// 系列徽标文案:如「Astro 7 上手 · 1/3」(仅文章有 series 字段)
function seriesLabel(post: (typeof all)[number]): string | undefined {
  if (post.collection !== 'articles') return undefined;
  const { series, seriesOrder } = post.data;
  if (!series) return undefined;
  const total = seriesMap.get(series) ?? 1;
  return `${series} · ${seriesOrder ?? '?'}/${total}`;
}
---
<BaseLayout>
  <div class="container">
    <header class="blog-hero">
      <p class="eyebrow">个人博客 · GITHUB PAGES · SINCE 2026</p>
      <h1>loong-blog</h1>
      <p class="lead">关于 Astro、前端工程与长期主义的记录——长文沉下去,随笔浮上来。</p>
    </header>

    <div class="home-grid grid-2-1">
      <!-- 列表区 -->
      <section aria-label="内容列表">
        <div class="list-tabs" role="tablist" aria-label="内容类型">
          <button class="tab is-active" role="tab" aria-selected="true" data-filter="all">全部 <span class="count">{all.length}</span></button>
          <button class="tab" role="tab" aria-selected="false" data-filter="articles">文章 <span class="count">{articleList.length}</span></button>
          <button class="tab" role="tab" aria-selected="false" data-filter="notes">随笔 <span class="count">{noteList.length}</span></button>
        </div>

        <div class="list-pane" data-pane="all">
          {all.map((post) => <PostCard post={post} seriesLabel={seriesLabel(post)} />)}
        </div>
        <div class="list-pane" data-pane="articles" hidden>
          {articleList.map((post) => <PostCard post={post} seriesLabel={seriesLabel(post)} />)}
        </div>
        <div class="list-pane" data-pane="notes" hidden>
          {noteList.map((post) => <PostCard post={post} seriesLabel={seriesLabel(post)} />)}
        </div>
      </section>

      <!-- 侧栏 -->
      <aside class="sidebar">
        <div class="sidebar-block">
          <h3 class="sidebar-title">标签</h3>
          <TagList tags={tags} />
        </div>
        {seriesList.length > 0 && (
          <div class="sidebar-block">
            <h3 class="sidebar-title">系列</h3>
            <nav class="series-list" aria-label="文章系列">
              {seriesList.map((s) => (
                <a href={withBase('/series')}>
                  <span>{s.name}</span>
                  <span class="meta">{s.count} 篇</span>
                </a>
              ))}
            </nav>
          </div>
        )}
        <div class="sidebar-block side-about">
          <h3 class="sidebar-title">关于</h3>
          <p>你好,我是 LeonidasLux。技术实践者,偶尔写点长文。这个博客托管在 GitHub Pages,零后端、静态优先。</p>
          <a class="btn btn-ghost btn-arrow" href={withBase('/about')}>了解更多</a>
        </div>
      </aside>
    </div>
  </div>

  <!-- 订阅条 -->
  <section class="subscribe">
    <div class="container">
      <p class="eyebrow subscribe-eyebrow">订阅 · RSS</p>
      <h2 class="subscribe-title">不想错过新文章?</h2>
      <p class="lead subscribe-lead">通过 RSS 订阅全部文章与随笔——零追踪、零噪音,回到阅读本身。</p>
      <a class="btn btn-primary" href={withBase('/rss.xml')}>订阅 RSS</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Tab 切换:三份静态列表,仅在客户端切换显示(不影响 SEO)
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panes = document.querySelectorAll<HTMLElement>('[data-pane]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      panes.forEach((p) => { p.hidden = p.dataset.pane !== tab.dataset.filter; });
    });
  });
</script>

<style>
  /* ── hero ── */
  .blog-hero {
    padding-block: clamp(56px, 9vw, 120px) clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--gap-xl);
  }
  .blog-hero h1 { font-size: var(--fs-hero); margin-bottom: var(--gap-md); }
  .home-grid { padding-bottom: clamp(48px, 7vw, 96px); }

  /* ── tabs ── */
  .list-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--color-line); margin-bottom: var(--gap-lg); }
  .tab {
    background: none;
    border: 0;
    padding: 12px 4px;
    margin-right: 28px;
    font-size: 13px;
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  .tab:hover { color: var(--color-ink); }
  .tab.is-active { color: var(--color-ink); border-bottom-color: var(--color-ink); }
  .tab .count { opacity: 0.7; margin-left: 4px; }

  /* ── 侧栏 ── */
  .sidebar { position: sticky; top: 88px; }
  .sidebar-block { padding-bottom: var(--gap-lg); margin-bottom: var(--gap-lg); border-bottom: 1px solid var(--color-line); }
  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .series-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    font-size: 14px;
    color: var(--color-ink);
    border-bottom: 1px dashed var(--color-line);
    gap: var(--gap-xs);
  }
  .series-list a:hover { box-shadow: inset 0 -1px 0 var(--color-accent); }
  .side-about p { font-size: 14px; color: var(--color-muted); line-height: 1.6; margin: 0 0 14px; }

  /* ── 订阅条 ── */
  .subscribe { border-top: 1px solid var(--color-line); }
  .subscribe .container { text-align: center; padding-block: clamp(48px, 7vw, 80px); }
  .subscribe-eyebrow { color: var(--color-muted); }
  .subscribe-title { font-size: clamp(24px, 3vw, 34px); margin-bottom: 10px; }
  .subscribe-lead { margin: 0 auto 24px; }
</style>